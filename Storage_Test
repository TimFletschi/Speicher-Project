import pandas as pd
from pyomo.environ import *

# ------------------------------
# 1. Daten laden
# ------------------------------
prices = pd.read_csv(r"C:\Users\TimFletschinger\OneDrive - empact GmbH\Desktop\04 Simulation\Spotmarktpreis.csv")["price"].values        #  €/kWh
pv = pd.read_csv(r"C:\Users\TimFletschinger\OneDrive - empact GmbH\Desktop\04 Simulation\pv_Daten.csv")["pv"].values                 # kWh PV-Erzeugung je Stunde

T = len(prices)

# Wirkungsgrad des Speichers
eta_dis = 0.95

# ------------------------------
# 2. Modell erstellen
# ------------------------------
model = ConcreteModel()

model.T = RangeSet(0, T-1)

# Variablen
model.dis = Var(model.T, domain=NonNegativeReals)      # Entladung
model.soc = Var(model.T, domain=NonNegativeReals)      # Ladezustand

# Optimierte Speicherparameter
model.E_max = Var(domain=NonNegativeReals)             # Kapazität
model.P_max = Var(domain=NonNegativeReals)             # max. Entladeleistung

# ------------------------------
# 3. Nebenbedingungen
# ------------------------------

# SOC-Dynamik: Speicher wird nur durch PV geladen
def soc_balance(m, t):
    if t == 0:
        return m.soc[t] == m.soc[T-1] + pv[t] - m.dis[t]/eta_dis
    else:
        return m.soc[t] == m.soc[t-1] + pv[t] - m.dis[t]/eta_dis
model.soc_balance = Constraint(model.T, rule=soc_balance)

# SOC <= Kapazität
def soc_cap(m, t):
    return m.soc[t] <= m.E_max
model.soc_cap = Constraint(model.T, rule=soc_cap)

# SOC >= 0
def soc_min(m, t):
    return m.soc[t] >= 0
model.soc_min = Constraint(model.T, rule=soc_min)

# Entladeleistung begrenzen
def p_lim(m, t):
    return m.dis[t] <= m.P_max
model.p_lim = Constraint(model.T, rule=p_lim)

# ------------------------------
# 4. Zielfunktion: Erlöse mit Speicher
# ------------------------------
def revenue_with_battery(m):
    return sum(prices[t] * m.dis[t] for t in m.T)
model.obj = Objective(rule=revenue_with_battery, sense=maximize)

# ------------------------------
# 5. Optimieren
# ------------------------------
solver = SolverFactory("glpk")
solver.solve(model)

# ------------------------------
# 6. Erlös ohne Speicher
# ------------------------------
revenue_no_battery = sum(prices[t] * pv[t] for t in range(T))

# ------------------------------
# 7. Ergebnisse ausgeben
# ------------------------------
print("====== Ergebnisse ======")
print("Erlös ohne Speicher:        ", revenue_no_battery)
print("Erlös mit Speicher:         ", model.obj())
print("Optimaler Speicher (kWh):   ", model.E_max.value)
print("Optimale Leistung (kW):     ", model.P_max.value)